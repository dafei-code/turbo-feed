target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# IDEA
.idea/
*.iml
*.ipr
*.iws

# macOS
.DS_Store

# 日志与本地配置
logs/
*.log
application-local.yml
shardingsphere-config-local.yml

# 环境变量密钥文件：由 `cp .env.example .env` 生成，含 JWT 密钥 / 内部令牌 / MinIO 凭据，绝不入仓
.env

# 测试运行残片（本地启动/种子脚本生成的临时数据，绝不入仓）
data/

# 构建产物：Maven dependency:build-classpath 输出的 classpath 文件（按模块根生成，环境相关，绝不入仓）
cp.txt
**/cp.txt

# 工作目录下的本地覆盖配置（Spring Boot 默认加载 file:./application.yml，
# 优先级高于 classpath，用于放本机 MinIO/Redis/JWT 等凭据）。
# ⚠️ 只忽略"工作目录"位置的 application.yml（仓库根与各部署单元模块根），
#    绝不忽略 src/main/resources/application.yml（那是被跟踪的默认配置）。
#    tf-feed-engine 同属部署单元：B1 拆分后它也要独立启动，本机同样需要一份覆盖配置。
/application.yml
/tf-gateway/application.yml
/tf-feed-engine/application.yml

# 本地 AI 助手会话目录（工作记忆、日志等），属个人环境产物，绝不该进仓。
# CI 里另有一条检查（.github/workflows/ci.yml 的「工作区卫生」）兜底：
# 即使本行被谁误删，只要它被 git 跟踪就会立刻失败——忽略规则和门禁各管一层。
.workbuddy/
