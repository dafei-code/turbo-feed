<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.turbofeed</groupId>
    <artifactId>turbo-feed</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>turbo-feed</name>
    <description>短视频 Feed 核心系统：推拉结合 Feed 流 + 分布式计数服务 + 热点治理（架构展示型开源项目）</description>

    <modules>
        <module>tf-shared</module>
        <!-- Redis 接入的单一事实源（库模块，非部署单元）：必须早于依赖它的服务模块声明 -->
        <module>tf-redis</module>
        <module>tf-hotspot</module>
        <module>tf-feed-engine</module>
        <module>tf-counter</module>
        <module>tf-gateway</module>
        <module>tf-benchmark</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 版本统一在父 POM 管理 -->
        <spring-boot.version>3.4.3</spring-boot.version>
        <!-- Spring Cloud 版本：必须与 spring-cloud-alibaba 对齐。
             Sentinel starter 内部有 Spring Cloud release train 兼容检查，启动 fail-fast。
             SCA 2023.0.3.4 的 parent 是 spring-cloud-dependencies-parent:4.1.0，对应 Spring Cloud 2024.0.x。
             Spring Cloud 2024.0.2 (2025-07) 与 SCA 2023.0.3.4 (2025-10) 发布时间窗最接近，社区最稳。
             Spring Cloud 2024.0.x 对应 Spring Boot 3.4.x，2023.0.x 仅对应 Boot 3.2/3.3。 -->
        <spring-cloud.version>2024.0.2</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.3.4</spring-cloud-alibaba.version>
        <redisson.version>3.27.2</redisson.version>
        <!-- ArchUnit（M1/3.1）：把「架构决策」写成可执行规则。版本 1.3.0 与 JUnit 5.11（Boot 3.4）
             兼容；只用于测试，不进任何运行期 classpath。 -->
        <archunit.version>1.3.0</archunit.version>
        <!-- caffeine / h2 / mysql-connector-j 由 spring-boot-dependencies BOM 托管，无需声明版本 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud BOM（必须早于 spring-cloud-alibaba-dependencies import，
                 SCA 的 BOM 只管理自身版本，Spring Cloud 本身版本由本 BOM 锁定） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba BOM（Sentinel） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- commons-lang3：覆盖 spring-boot-dependencies 3.4.3 BOM 锁定的 3.17.0。
                 ShardingSphere 5.5.3 的 SystemSchemaManager 静态引用 org.apache.commons.lang3.Strings，
                 该 class 在 commons-lang3 3.18.0 才引入（3.17.0 无 Strings.class）→ 否则 NoClassDefFoundError。
                 本地 .m2 已有 3.18.0，无需联网下载。 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.18.0</version>
            </dependency>
            <!-- Redisson 核心库（不含 Spring Boot 自动配置）：M1/3.2 起由 tf-redis 统一装配
                 RedissonClient，引用方只依赖 core，避免 starter 的 RedissonAutoConfigurationV2
                 在"没配 Redis 也尝试连 127.0.0.1:6379"导致启动失败。
                 ⚠️ 刻意【不】托管 redisson-spring-boot-starter：已经没有模块用它（tf-counter 的
                 私有 CounterRedisConfig 已删）。不留版本托管 = 谁再写这个 dependency 都会因
                 "version 缺失"编译失败，把"别引 starter"从口头约定变成构建期硬约束。 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!-- ArchUnit（M1/3.1）：架构约束的可执行化。scope 直接钉死 test —— 它是构建期
                 门禁，绝不能出现在任何运行期 classpath 上（会带进 ASM 等字节码依赖）。 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- RocketMQ：钉死 2.3.5（2.3.x 最新，对 Spring Boot 3.4.x 的 @ConfigurationProperties 绑定兼容）。
                 关键点：spring-cloud-alibaba-dependencies BOM 会把内层 rocketmq-spring-boot
                 （承载 RocketMQProperties / RocketMQUtil 真实类）管理成 2.3.0；2.3.0 与 Boot 3.4.3
                 绑定不兼容，导致 rocketmq.name-server 绑不上、消费者启动报 connect to null。
                 此处强制覆盖 starter 与内层版本，避免 SCA BOM 把内层拉成 2.3.0。 -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>2.3.5</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot</artifactId>
                <version>2.3.5</version>
            </dependency>
            <!-- rocketmq-client / rocketmq-acl：starter 2.3.5 的 parent 实际声明 rocketmq.version=5.3.2，
                 但 SCA BOM 又把它们覆盖成 5.3.1（patch 差）。显式钉 5.3.2 与 starter 期望完全一致，
                 消除 client/starter 版本错位可能带来的 namesrv 地址透传异常。 -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-client</artifactId>
                <version>5.3.2</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-acl</artifactId>
                <version>5.3.2</version>
            </dependency>
            <!-- Flyway：Spring Boot 3.4.x 未发布 spring-boot-starter-flyway（该 starter 仅 4.x 起存在），
                 改用 BOM 托管的 org.flywaydb:flyway-core + flyway-mysql（版本由 spring-boot-dependencies 统一为 10.20.1）。
                 flyway-core 为引擎、flyway-mysql 提供 MySQL 方言；spring-boot-autoconfigure 的 FlywayAutoConfiguration
                 会在 flyway-core 位于 classpath 且 spring.flyway.enabled=true 时自动执行迁移。 -->
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.turbofeed</groupId>
                <artifactId>tf-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.turbofeed</groupId>
                <artifactId>tf-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.turbofeed</groupId>
                <artifactId>tf-hotspot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.turbofeed</groupId>
                <artifactId>tf-feed-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.turbofeed</groupId>
                <artifactId>tf-counter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Testcontainers BOM：真集成测试（MySQL + Redis）版本统一托管。
                 仅影响 testcontainers 系 artifact，不污染主依赖；版本固定 1.20.4（兼容 JUnit 5.11 / Boot 3.4.3）。 -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.20.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
            <!-- 显式带 surefire（3.2.5）：本父 pom 是普通 BOM 父（非 spring-boot-starter-parent），
                 不会自动注入 surefire + JUnit5 运行时。3.x 原生支持 JUnit5，配 junit-platform-launcher（模块 test 依赖）即可跑。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- JaCoCo（M3 质量工程）：0.8.11 为本地 .m2 已有版本，离线可跑。
                 未选更新版本是因为本机不联网，而「能在本机复现 CI 结果」比版本号新更重要。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
            </plugin>
        </plugins>
    </pluginManagement>
    </build>

    <profiles>
        <!-- ci：CI 专属的额外门禁（覆盖率）。**只在 CI 激活，本地默认不激活**——
             两个原因：① JaCoCo 会对所有测试做字节码插桩，让本地日常构建明显变慢；
             ② 本机 .m2 里 JaCoCo 的传递依赖不完整（asm / plexus-utils 等缺失），离线跑会直接失败，
             放进 profile 可保证「本地离线构建永远不被覆盖率工具拖垮」。CI 有网，能正常解析。
             代价是本地跑不出覆盖率报告；想看时手动 `mvn -Pci verify`（需联网）。 -->
        <profile>
            <id>ci</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <!-- report 绑 prepare-package 而非 test：surefire 的 test goal 也绑在 test 阶段，
                                 同阶段内执行顺序取决于 POM 声明顺序，绑 test 有「报告先于测试执行、
                                 结果全零」的风险；prepare-package 稳在 test 之后、package 之前。 -->
                            <execution>
                                <id>report</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- local：在 /Volumes/D（APFS protect 卷）上构建时，spring-boot-maven-plugin 的 repackage
             会对 mmap 打开的 jar 执行 renameTo，而该挂载下 rename() 对 mmap 文件返回失败
             （"Unable to rename ... to ...jar.original"）。本地运行用 -cp target/classes 不需要 fat jar，
             故本 profile 跳过 repackage，使 `mvn -Plocal package` 在 D 盘可过。
             CI / 生产构建（Linux）不激活本 profile，仍跑完整 repackage 出可执行 jar。 -->
        <profile>
            <id>local</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
