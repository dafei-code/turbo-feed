<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.turbofeed</groupId>
    <artifactId>turbo-feed</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>turbo-feed</name>
    <description>短视频 Feed 核心系统：推拉结合 Feed 流 + 分布式计数服务 + 热点治理（架构展示型开源项目）</description>

    <modules>
        <module>tf-shared</module>
        <module>tf-hotspot</module>
        <module>tf-feed-engine</module>
        <module>tf-counter</module>
        <module>tf-gateway</module>
        <module>tf-benchmark</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 版本统一在父 POM 管理 -->
        <spring-boot.version>3.4.3</spring-boot.version>
        <!-- Spring Cloud 版本：必须与 spring-cloud-alibaba 对齐。
             Sentinel starter 内部有 Spring Cloud release train 兼容检查，启动 fail-fast。
             SCA 2023.0.3.4 的 parent 是 spring-cloud-dependencies-parent:4.1.0，对应 Spring Cloud 2024.0.x。
             Spring Cloud 2024.0.2 (2025-07) 与 SCA 2023.0.3.4 (2025-10) 发布时间窗最接近，社区最稳。
             Spring Cloud 2024.0.x 对应 Spring Boot 3.4.x，2023.0.x 仅对应 Boot 3.2/3.3。 -->
        <spring-cloud.version>2024.0.2</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.3.4</spring-cloud-alibaba.version>
        <redisson.version>3.27.2</redisson.version>
        <!-- caffeine / h2 / mysql-connector-j 由 spring-boot-dependencies BOM 托管，无需声明版本 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud BOM（必须早于 spring-cloud-alibaba-dependencies import，
                 SCA 的 BOM 只管理自身版本，Spring Cloud 本身版本由本 BOM 锁定） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba BOM（Sentinel） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- commons-lang3：覆盖 spring-boot-dependencies 3.4.3 BOM 锁定的 3.17.0。
                 ShardingSphere 5.5.3 的 SystemSchemaManager 静态引用 org.apache.commons.lang3.Strings，
                 该 class 在 commons-lang3 3.18.0 才引入（3.17.0 无 Strings.class）→ 否则 NoClassDefFoundError。
                 本地 .m2 已有 3.18.0，无需联网下载。 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.18.0</version>
            </dependency>
            <!-- Redisson -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!-- RocketMQ：钉死 2.3.5（2.3.x 最新，对 Spring Boot 3.4.x 的 @ConfigurationProperties 绑定兼容）。
                 关键点：spring-cloud-alibaba-dependencies BOM 会把内层 rocketmq-spring-boot
                 （承载 RocketMQProperties / RocketMQUtil 真实类）管理成 2.3.0；2.3.0 与 Boot 3.4.3
                 绑定不兼容，导致 rocketmq.name-server 绑不上、消费者启动报 connect to null。
                 此处强制覆盖 starter 与内层版本，避免 SCA BOM 把内层拉成 2.3.0。 -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>2.3.5</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot</artifactId>
                <version>2.3.5</version>
            </dependency>
            <!-- rocketmq-client / rocketmq-acl：starter 2.3.5 的 parent 实际声明 rocketmq.version=5.3.2，
                 但 SCA BOM 又把它们覆盖成 5.3.1（patch 差）。显式钉 5.3.2 与 starter 期望完全一致，
                 消除 client/starter 版本错位可能带来的 namesrv 地址透传异常。 -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-client</artifactId>
                <version>5.3.2</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-acl</artifactId>
                <version>5.3.2</version>
            </dependency>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.turbofeed</groupId>
                <artifactId>tf-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.turbofeed</groupId>
                <artifactId>tf-hotspot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.turbofeed</groupId>
                <artifactId>tf-feed-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.turbofeed</groupId>
                <artifactId>tf-counter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
