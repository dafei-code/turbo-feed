<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.turbofeed</groupId>
        <artifactId>turbo-feed</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tf-feed-engine</artifactId>
    <name>tf-feed-engine</name>
    <description>Feed 推拉结合核心（独立部署单元，默认端口 8083）：收件箱（Redis List + LTRIM）
        / 大 V outbox（ZSET）/ 活跃度分层 / 扇出 Worker / 多路归并聚合</description>

    <dependencies>
        <dependency>
            <groupId>com.turbofeed</groupId>
            <artifactId>tf-shared</artifactId>
        </dependency>
        <!-- 热点治理为进程内 SDK（本地 L1 缓存 + 热点广播），以库形式嵌入本服务，非独立部署单元 -->
        <dependency>
            <groupId>com.turbofeed</groupId>
            <artifactId>tf-hotspot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 健康检查（K8s 探活 / 未来 Prometheus 指标入口） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Redis 客户端（Lettuce）：时间线 ZSET 与推荐流旁路缓存只需 RedisTemplate 级原子命令
             （ZADD / ZREM / ZREVRANGEBYSCORE），不需要分布式锁与 Redisson 的丰富数据结构，
             故不引入 redisson-spring-boot-starter。

             ⚠️ 踩坑记录：redisson-spring-boot-starter 虽然传递了 spring-boot-starter-data-redis，
             但把它内部的 lettuce-core 与 jedis 一并 <excluded> 掉了——只留自动配置、不留任何客户端
             实现。此时 RedisAutoConfiguration 加载 LettuceConnectionConfiguration 会抛
             ClassNotFoundException: io.lettuce.core.RedisClient，应用启动即失败。
             因此这里直接声明官方 starter（自带 lettuce-core），依赖面更小、语义更直白。

             Lettuce 连接懒建立：本地未启动 Redis 不影响应用启动 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Lettuce 连接池依赖：commons-pool2 是 lettuce-core 的 optional 依赖，不会随
             spring-boot-starter-data-redis 传递引入；application.yml 启用了
             lettuce.pool.enabled=true，必须显式声明，否则启动报
             NoClassDefFoundError: org/apache/commons/pool2/impl/GenericObjectPoolConfig。
             版本由 spring-boot-dependencies BOM 托管，无需写 version。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <!-- RocketMQ（B2：Feed 时间线顺序消息消费）。引擎仅消费、无需 producer.group；
             rocketmq.* 连接配置放 application-mq.yml（profile=mq）。版本由 root pom
             dependencyManagement 钉 2.3.5，此处不写 version。 -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Lombok：@Slf4j / @RequiredArgsConstructor。骨架期本模块只有启动类、无需简化注解，
             随 Feed 时间线实现落地而引入，与 tf-gateway 保持一致的工程风格。
             版本由 spring-boot-dependencies BOM 托管；optional 不参与传递、不打入可执行 jar -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.turbofeed.feedengine.FeedEngineApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
