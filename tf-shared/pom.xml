<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.turbofeed</groupId>
        <artifactId>turbo-feed</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tf-shared</artifactId>
    <name>tf-shared</name>
    <description>公共模型与 SPI：User / FeedItem / LikeEvent / MqProvider / InboxStore / CounterStore</description>

    <!-- 纯模型与 SPI 模块，零第三方依赖，保证被所有模块引用时不引入传递依赖 -->

    <dependencies>
        <!-- 测试运行时（test scope，不向引用方传递，不破坏「零第三方依赖」定位）：
             JUnit5 + Mockito + AssertJ 版本由 spring-boot-dependencies BOM 托管。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- surefire 3.x 跑 JUnit5 必需（BOM 父不自动带 junit-platform-launcher）。 -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 开启 -parameters：契约 record（如 FeedItemView）的 JSON 反序列化依赖「类文件中
                 保留形参名」——Jackson 的 ParameterNamesModule 通过 Parameter#getName() 读取
                 record 规范构造器的形参名，而未经此配置时形参名只编译为 arg0/arg1，反序列化
                 会抛 InvalidDefinitionException（网关侧 MediaItem 当初为此才加了 @JsonProperty）。

                 为什么只在 tf-shared 开：形参名随 FeedItemView.class 一并被下游
                 （tf-feed-engine / tf-gateway）读取，本刀范围内下游无需各自开启；同时避免为
                 一个契约问题去改根 pom 的全局编译参数。

                 为什么不加 jackson-annotations：本模块定位「零第三方依赖」，加注解等于给所有
                 引用方（含 tf-counter）引入一个非必要传递依赖。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
