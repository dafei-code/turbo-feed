<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.turbofeed</groupId>
        <artifactId>turbo-feed</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tf-shared</artifactId>
    <name>tf-shared</name>
    <description>公共模型与 SPI：User / FeedItem / LikeEvent / MqProvider / InboxStore / CounterStore</description>

    <!-- 纯模型与 SPI 模块，零第三方依赖，保证被所有模块引用时不引入传递依赖 -->

    <dependencies>
        <!-- 测试运行时（test scope，不向引用方传递，不破坏「零第三方依赖」定位）：
             JUnit5 + Mockito + AssertJ 版本由 spring-boot-dependencies BOM 托管。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- surefire 3.x 跑 JUnit5 必需（BOM 父不自动带 junit-platform-launcher）。 -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit（M1/3.1）：把「tf-shared 零第三方依赖」这条定位写成可执行规则——
             它是被所有服务内嵌的共享库，一旦被谁塞进 Spring/Jackson 依赖，等于把框架
             耦合扩散到每个服务。test scope，不向引用方传递。 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JSON 往返回归测试（M2/4.1）：契约 record 的字段名就是跨服务协议本身，
             必须有一条测试把「序列化出来的 JSON」写死，字段漂移即红。
             test scope，不向引用方传递——本模块对外的「零第三方依赖」定位不变。

             ⚠️ 为什么测试需要一个序列化器：契约测试验的是「JSON 长什么样」，
             不验 Jackson 本身。用真实的 Jackson 跑，才能覆盖 Instant 时间格式、
             record 反序列化、未知字段这些真正会炸的地方。
             jackson-datatype-jsr310 用于 java.time.Instant（契约里有 createdAt/occurredAt）。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 开启 -parameters：保留形参名（M2/4.1 实测更正过结论，勿再照抄旧注释）。

                 ⚠️ 更正（2026-10-26 实测）：本模块【所有契约都是 record】，而 Jackson 2.12+
                 通过 Class#getRecordComponents() 拿组件名，【不依赖】本参数——用裸 ObjectMapper
                 （连 ParameterNamesModule 都不注册）完整往返六个契约全部通过。此前「反序列化依赖
                 -parameters、不开就抛 InvalidDefinitionException」的说法是把【普通类】的经验
                 套到了 record 上，是错的，代码注释与文档已同步订正。该结论由
                 SharedContractJsonTest#record不依赖编译期形参名 固化，误关本参数会立刻在 CI 变红。

                 为什么仍然保留：① 非 record 类（若将来新增走构造器绑定的普通类）仍需要它；
                 ② 反射诊断与框架内省场景需要真实形参名；③ 零运行时成本。保留但不再声称它是
                 record 序列化的前提——不写清楚，下一个人又不敢删、也不敢信。

                 为什么只在 tf-shared 开：契约类都在这里，形参名随 .class 一并被下游读取，
                 无需为它去改根 pom 的全局编译参数。

                 为什么不加 jackson-annotations（@JsonProperty/@JsonIgnore）：本模块定位
                 「零第三方依赖」，加注解等于给所有引用方（含 tf-counter）引入一个非必要传递依赖。
                 命中 Jackson 默认行为的坑（如 is 前缀被当属性）一律【从命名上绕开】，
                 而不是加注解——Result#succeeded() 与 FeedTimelineEvent 的常量比较都是这么处理的。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
