<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.turbofeed</groupId>
        <artifactId>turbo-feed</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tf-hotspot</artifactId>
    <name>tf-hotspot</name>
    <description>热点探测与治理：滑动窗口热 Key 探测 + 广播 + 热/冷桶迁移合并 + Caffeine L1 本地缓存</description>

    <dependencies>
        <dependency>
            <groupId>com.turbofeed</groupId>
            <artifactId>tf-shared</artifactId>
        </dependency>
        <!-- L1 本地缓存（版本由 Spring Boot BOM 托管） -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- 日志门面（tf-shared 定位「零第三方依赖」，不传递；SDK 需显式声明）。版本由 spring-boot-dependencies BOM 托管。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- 测试（test scope，不向引用方传递）：JUnit5 + Mockito + AssertJ，版本由 BOM 托管。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
