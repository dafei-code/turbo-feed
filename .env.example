# turbo-feed 全栈编排环境变量样例
# 用法：cp .env.example .env 后填入真实值；.env 含密钥，务必加入 .gitignore（切勿提交）
#
# 变量说明：
#   TURBOFEED_DB_USERNAME / TURBOFEED_DB_PASSWORD
#       MySQL root 账号与密码，同时被 ShardingSphere（网关）经 TURBOFEED_DB_* 注入。
#   TURBOFEED_REDIS_PASSWORD
#       Redis 密码；空串=无密码（单节点开发形态）。集群/哨兵改 TURBOFEED_REDIS_MODE 并补节点变量。
#   TURBOFEED_JWT_SECRET
#       JWT 签发密钥（必填，≥32 位）。缺失则网关启动失败——杜绝仓库 demo 串兜底被生产静默使用。
#   TURBOFEED_SNOWFLAKE_WORKER_ID / TURBOFEED_SNOWFLAKE_DATACENTER_ID
#       雪花 ID 实例标识（各 0~31）。多实例部署须逐实例不同，否则同一毫秒生成相同主键导致插入冲突。
#   TURBOFEED_MINIO_ACCESS_KEY / TURBOFEED_MINIO_SECRET_KEY
#       对象存储 MinIO 凭据（与 compose 中 MINIO_ROOT_USER/PASSWORD 保持一致）。
#   TURBOFEED_INTERNAL_TOKEN
#       服务间内部接口共享令牌（网关↔引擎 /internal/** 必须两端一致），未配置则两侧均 fail-open。

# ===== 数据库 =====
TURBOFEED_DB_USERNAME=root
TURBOFEED_DB_PASSWORD=root

# ===== Redis =====
TURBOFEED_REDIS_PASSWORD=

# ===== JWT =====
TURBOFEED_JWT_SECRET=please-change-me-to-a-long-random-secret-at-least-32-chars

# ===== 雪花 ID 实例标识 =====
TURBOFEED_SNOWFLAKE_WORKER_ID=1
TURBOFEED_SNOWFLAKE_DATACENTER_ID=1

# ===== MinIO =====
TURBOFEED_MINIO_ACCESS_KEY=minioadmin
TURBOFEED_MINIO_SECRET_KEY=minioadmin

# ===== 服务间内部令牌 =====
TURBOFEED_INTERNAL_TOKEN=change-me-internal-token
