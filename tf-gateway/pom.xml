<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.turbofeed</groupId>
        <artifactId>turbo-feed</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tf-gateway</artifactId>
    <name>tf-gateway</name>
    <description>HTTP 接入层：对外 API 聚合入口 + 认证 + 媒体上传（可执行 jar，默认端口 8080）+ Sentinel 流量防护。
        微服务拆分后为独立部署单元：与 tf-counter / tf-feed-engine 通过 HTTP（同步）与 RocketMQ（异步）通信，
        不再以 Maven 依赖方式内嵌引擎模块。</description>

    <dependencies>
        <dependency>
            <groupId>com.turbofeed</groupId>
            <artifactId>tf-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 健康检查（K8s 探活 / 未来 Prometheus 指标入口），与 tf-counter / tf-feed-engine 对齐 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Sentinel：timeline QPS 限流 + 点赞热点参数限流 + 依赖熔断 + 系统自适应保护 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <!-- Redis（Lettuce）：上传接口用户级限流等轻量 KV 用途（版本由 Boot BOM 托管）。
             与 tf-counter / tf-feed-engine 的 Redisson 是不同选型：网关只需 RedisTemplate 级
             原子命令（INCR/EXPIRE），不需要分布式锁与丰富数据结构，避免重依赖。
             Lettuce 连接懒建立：本地未启动 Redis 不影响应用启动 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- ShardingSphere JDBC 内核：分库分表原生驱动（驱动类 org.apache.shardingsphere.driver.ShardingSphereDriver，
             由 application.yml 的 spring.datasource.url=jdbc:shardingsphere:classpath:shardingsphere-config.yaml 启用，
             无需 spring-boot-starter）。当前仅网关元数据(user 表)分片使用；
             实际分片算法用 Apache ShardingSphere 5.5.3 内置 HASH_MOD（type: HASH_MOD + props.sharding-count），
             见 shardingsphere-config.yaml shardingAlgorithms 段；不需业务侧自定义算法类（曾自写但已于 0012 改回内置）。
             ⚠️ artifactId 必须是 `shardingsphere-jdbc`（5.x 统一名称），不是 `shardingsphere-jdbc-core`，
             后者在 Maven Central 不存在，会导致 import org.apache.shardingsphere.* 全军报红。
             版本选择：5.5.3（2026-02-23 发布），相比 5.5.0 已修复 test-util 缺失发布的 release 缺陷，
             详见 Apache PR #31143（"Removes test modules that are not deployed to Maven Central Repository"）与
             GitHub issue #31128/#32256。 -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-jdbc</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- RocketMQ：媒体上传事件异步化（Observer 事件总线的跨进程实现）。
             2.3.x 兼容 Spring Boot 3.x（2.3.4 已修复 MessageModel 包路径冲突）。
             默认不激活：未配置 rocketmq.name-server 时 starter 自动配置不生效，
             且自定义发布器/消费者由 turbofeed.mq.enabled=true 才激活（保克隆即跑） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.3.4</version>
        </dependency>
        <!-- Lombok：@RequiredArgsConstructor 简化构造器注入（版本由 Spring Boot BOM 托管；optional 不参与传递、不打入可执行 jar） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.turbofeed.gateway.GatewayApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
