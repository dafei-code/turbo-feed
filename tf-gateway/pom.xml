<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.turbofeed</groupId>
        <artifactId>turbo-feed</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tf-gateway</artifactId>
    <name>tf-gateway</name>
    <description>HTTP 接入层：对外 API 聚合入口 + 认证 + 媒体上传（可执行 jar，默认端口 8080）+ Sentinel 流量防护。
        微服务拆分后为独立部署单元：与 tf-counter / tf-feed-engine 通过 HTTP（同步）与 RocketMQ（异步）通信，
        不再以 Maven 依赖方式内嵌引擎模块。</description>

    <dependencies>
        <dependency>
            <groupId>com.turbofeed</groupId>
            <artifactId>tf-shared</artifactId>
        </dependency>
        <!-- Redis 接入单一事实源：拓扑装配（单机/哨兵/集群）由该模块的 AutoConfiguration 提供。
             引入即生效（无需 @Import），保证网关与 tf-feed-engine 读同一套 turbofeed.redis.*。 -->
        <dependency>
            <groupId>com.turbofeed</groupId>
            <artifactId>tf-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 健康检查（K8s 探活 / 未来 Prometheus 指标入口），与 tf-counter / tf-feed-engine 对齐 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus 指标暴露（P0-4 可观测性）：actuator 已传递 micrometer-core，
             本依赖仅补充 PrometheusMeterRegistry + /actuator/prometheus 端点；
             版本由 spring-boot-dependencies BOM 托管，无需写 version。与 tf-feed-engine 对齐。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- JDBC 持久层：media 元数据落库（P1）。复用 ShardingSphere 已装配的 DataSource，
             经 JdbcTemplate 读写分片后的 media 表；版本由 Spring Boot BOM 托管。
             一并带来 HikariCP，与 shardingsphere-config.yaml 引用的 HikariDataSource 对齐。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Flyway schema 版本管理（P0-3）：仅版本化「单表」(SINGLE 规则登记的 5 张)，
             分片表(540 张)仍由 init-local.sql 模板脚本生成，不纳入 Flyway。
             默认关闭(spring.flyway.enabled=false)，直连物理库 turbo_feed_1 绕过 ShardingSphere。
             Spring Boot 3.4.x 无 spring-boot-starter-flyway（仅 4.x 起），改用 BOM 托管的
             flyway-core(引擎) + flyway-mysql(MySQL 方言)，版本由 spring-boot-dependencies 统一(10.20.1)，无需写 version。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <!-- Sentinel：timeline QPS 限流 + 点赞热点参数限流 + 依赖熔断 + 系统自适应保护 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <!-- Nacos 服务发现 + Spring Cloud LoadBalancer（P0-5，ADR-002）：网关→引擎改用服务名寻址，
             多实例自动注册/健康检查/负载均衡/故障摘除。严格 opt-in：未配 spring.cloud.nacos.discovery.enabled
             且 turbofeed.feed.engine.service-name 为空时，行为与直连 base-url 完全一致（克隆即跑）；
             Nacos 地址/服务名缺省不发起任何连接。版本由 spring-cloud-alibaba-dependencies(2023.0.3.4)
             / spring-cloud-dependencies(2024.0.2) BOM 托管，无需写 version。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Sentinel 规则 Nacos 数据源（P0-5，ADR-002）：限流规则从本地代码注册切到 Nacos 热推，
             改规则无需重启。opt-in：turbofeed.sentinel.nacos.enabled=true 才激活，关闭时仍走现有
             SentinelRateLimitConfig 本地规则。解析用 Jackson converter 避 fastjson（见 SentinelNacosDataSourceConfig）。
             注意 GAV 是 com.alibaba.csp（原生 Sentinel 扩展，由 SCA BOM 的 ${sentinel.version} 托管），
             不是 com.alibaba.cloud；版本由 spring-cloud-alibaba-dependencies BOM 托管，无需写 version。 -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
        </dependency>
        <!-- Redis（Lettuce）：上传接口用户级限流等轻量 KV 用途（版本由 Boot BOM 托管）。
             与 tf-counter / tf-feed-engine 的 Redisson 是不同选型：网关只需 RedisTemplate 级
             原子命令（INCR/EXPIRE），不需要分布式锁与丰富数据结构，避免重依赖。
             Lettuce 连接懒建立：本地未启动 Redis 不影响应用启动 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Lettuce 连接池依赖：commons-pool2 是 lettuce-core 的 optional 依赖，不会随
             spring-boot-starter-data-redis 传递引入；application.yml 启用了
             lettuce.pool.enabled=true，必须显式声明，否则启动报
             NoClassDefFoundError: org/apache/commons/pool2/impl/GenericObjectPoolConfig。
             版本由 spring-boot-dependencies BOM 托管，无需写 version。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <!-- ShardingSphere JDBC 内核：分库分表原生驱动（驱动类 org.apache.shardingsphere.driver.ShardingSphereDriver，
             由 application.yml 的 spring.datasource.url=jdbc:shardingsphere:classpath:shardingsphere-config.yaml 启用，
             无需 spring-boot-starter）。当前仅网关元数据(user 表)分片使用；
             实际分片算法用 Apache ShardingSphere 5.5.3 内置 HASH_MOD（type: HASH_MOD + props.sharding-count），
             见 shardingsphere-config.yaml shardingAlgorithms 段；不需业务侧自定义算法类（曾自写但已于 0012 改回内置）。
             ⚠️ artifactId 必须是 `shardingsphere-jdbc`（5.x 统一名称），不是 `shardingsphere-jdbc-core`，
             后者在 Maven Central 不存在，会导致 import org.apache.shardingsphere.* 全军报红。
             版本选择：5.5.3（2026-02-23 发布），相比 5.5.0 已修复 test-util 缺失发布的 release 缺陷，
             详见 Apache PR #31143（"Removes test modules that are not deployed to Maven Central Repository"）与
             GitHub issue #31128/#32256。 -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-jdbc</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- ShardingSphere classpath: URL 加载器：shardingsphere-jdbc 5.5.3 的上游 pom 误把
             shardingsphere-infra-url-classpath 声明为 test scope，不会传递到使用方的运行时
             classpath，导致 jdbc:shardingsphere:classpath:shardingsphere-config.yaml 初始化报
             SPI-00001: No implementation class load from SPI 'ShardingSphereModeConfigurationURLLoader'
             with type 'classpath:'（HikariPool-1 起不来，首个碰库请求 500）。
             接口在 5.5.0→5.5.3 间由 ShardingSphereURLLoader 改名而来，实现类 ClassPathURLLoader
             仍在该模块。此处显式声明以覆盖上游 test scope（直接声明优先于传递依赖的 scope）。 -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-infra-url-classpath</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- ⚠️ ShardingSphere 5.5.3 上游打包回归：shardingsphere-jdbc:5.5.3.pom 把以下运行期
             必需模块全部声明为 <scope>test</scope>（见其 pom 第 91-135 行），不会传递到使用方的
             运行时 classpath，导致驱动初始化连环失败：
               · shardingsphere-sharding-core            → 缺则 YAML 解析报 Invalid tag: !SHARDING
               · shardingsphere-parser-sql-engine-mysql  → 缺则无法解析 MySQL 业务 SQL
               · shardingsphere-parser-sql-engine-sql92  → 通用 SQL 解析引擎（兜底）
               · shardingsphere-infra-data-source-pool-hikari → 缺则无法创建 Hikari 连接池数据源
               · shardingsphere-standalone-mode-repository-memory → 缺则 classpath 配置 standalone 内存仓库加载失败
               · shardingsphere-authority-simple         → 默认权限提供器（缺则 authority rule 构建失败）
               · shardingsphere-readwrite-splitting-core → 缺则 YAML 解析报 Invalid tag: !READWRITE_SPLITTING
             此处逐一显式声明 5.5.3 以覆盖上游 test scope（直接声明优先于传递依赖 scope）。
             唯一未声明的是 shardingsphere-test-infra-fixture-database（纯上游测试设施，使用方无需）。

             ⚠️ 2026-09-29 实测补记：读写分离（!READWRITE_SPLITTING）是后来才加进配置的，
             当时只补了 !SHARDING 需要的模块，漏了这一个，于是本地启动必炸
             "Invalid tag: !READWRITE_SPLITTING"。tag 常量来自本模块里的
             YamlReadwriteSplittingRuleConfigurationSwapper（经 SPI
             org.apache.shardingsphere.infra.yaml.config.swapper.rule.YamlRuleConfigurationSwapper 注册），
             jar 不在 classpath 上就等于 tag 未注册。**配置里每新增一种 !XXX 规则，
             都要确认对应模块已在本清单里。** 这也说明：只做 YAML 语法校验（pyyaml 之类）
             证明不了配置能被运行时接受，必须真启动一次。 -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-sharding-core</artifactId>
            <version>5.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-parser-sql-engine-mysql</artifactId>
            <version>5.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-parser-sql-engine-sql92</artifactId>
            <version>5.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-infra-data-source-pool-hikari</artifactId>
            <version>5.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-standalone-mode-repository-memory</artifactId>
            <version>5.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-authority-simple</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- 读写分离（!READWRITE_SPLITTING）：同上，上游声明为 test scope，必须显式补齐。 -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-readwrite-splitting-core</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- 密码哈希：Spring Security Crypto 的 BCryptPasswordEncoder（仅加密工具类，
             不引入 Spring Security Web / 鉴权自动配置；版本由 spring-boot-dependencies BOM 托管，无需写 version）。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- MySQL 驱动：ShardingSphere-JDBC 不内置任何数据库驱动，必须由应用侧显式声明！
             否则底层 Hikari 池建连时 ClassNotFoundException 被包装成
             "Failed to initialize pool: null"（message 为 null，根因被吞）。
             版本由 spring-boot-dependencies BOM 托管（Spring Boot 3.4.3 → mysql-connector-j 8.0.33/9.x，
             本地 .m2 已有 8.0.33，兼容）。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!-- ShardingSphere 5.5.3 运行期依赖 commons-lang3（SystemSchemaManager 静态初始化引用
             org.apache.commons.lang3.Strings）。⚠️ 关键坑：spring-boot-dependencies 3.4.3 BOM 把
             commons-lang3 锁定为 3.17.0，而 org.apache.commons.lang3.Strings 这个 class 直到
             commons-lang3 3.18.0 才引入（3.17.0 及更早版本根本没有 Strings.class），导致
             NoClassDefFoundError: org/apache/commons/lang3/Strings。此处显式锁 3.18.0 覆盖 BOM。
             本地 .m2 已有 3.18.0（含 Strings 类），无需联网下载；根 pom dependencyManagement 也同步覆盖。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>
        <!-- RocketMQ：媒体上传事件异步化（Observer 事件总线的跨进程实现）。
             2.3.x 兼容 Spring Boot 3.x（2.3.4 已修复 MessageModel 包路径冲突）。
             默认不激活：未配置 rocketmq.name-server 时 starter 自动配置不生效，
             且自定义发布器/消费者由 turbofeed.mq.enabled=true 才激活（保克隆即跑） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.3.5</version>
        </dependency>
        <!-- Lombok：@RequiredArgsConstructor / @Slf4j 简化构造器与日志（optional 不参与传递、不打入可执行 jar）。
             钉 1.18.42：本机 JDK 为 17.0.19（2026 补丁版），Lombok 1.18.36 的 TypeTag 反射在改版
             javac 内部 API 上抛 ExceptionInInitializerError，clean 编译时 @Slf4j 的 log 字段无法生成、
             全量报「找不到符号」；1.18.42 已适配该 JDK。覆盖 spring-boot-dependencies BOM 的 1.18.36。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.42</version>
            <optional>true</optional>
        </dependency>
        <!-- 对象存储客户端（MinIO / 兼容 S3）：百亿级媒体文件的存储落点。
             仅 turbofeed.media.storage=minio 时由 MinioStorageClient 使用（ConditionalOnProperty），
             默认 local 磁盘存储不会加载本依赖的任何类，不影响克隆即跑。Java 17 兼容（SDK 要求 11+）。 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.7</version>
        </dependency>

        <!-- ============ 测试（P0-1，ADR-001）============ -->
        <!-- spring-boot-starter-test：JUnit5 + Mockito + AssertJ。版本由 spring-boot-dependencies BOM 托管。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- junit-platform-launcher：surefire 3.x 跑 JUnit5 必需（BOM 父不自动带）。 -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers：真集成测试（UserJdbcRepository 分片路由需真实 MySQL）。
             版本由根 pom 的 testcontainers-bom 托管。集成测用 @RequiresDocker 守卫：无 Docker 时跳过而非失败。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- testcontainers 核心（@Testcontainers / MySQLContainer 的传递底座，显式声明锁定版本；
             版本由根 pom testcontainers-bom 托管。注意：@RequiresDocker 守卫已改为不依赖
             testcontainers 内部 DockerClientFactory，改用轻量 DockerEnvironment 探测，
             因此本依赖仅为集成测的容器本身服务）。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 显式把 Lombok 1.18.42 放到注解处理器路径：clean 编译时 javac 才能发现 @Slf4j/@RequiredArgsConstructor
                 处理器（本机 JDK 17.0.19 需 1.18.42，见 lombok 依赖注释）。与引擎 tf-feed-engine 一致。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.42</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.turbofeed.gateway.GatewayApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
