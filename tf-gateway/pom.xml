<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.turbofeed</groupId>
        <artifactId>turbo-feed</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tf-gateway</artifactId>
    <name>tf-gateway</name>
    <description>HTTP 接入层：对外 API 聚合入口 + 认证 + 媒体上传（可执行 jar，默认端口 8080）+ Sentinel 流量防护。
        微服务拆分后为独立部署单元：与 tf-counter / tf-feed-engine 通过 HTTP（同步）与 RocketMQ（异步）通信，
        不再以 Maven 依赖方式内嵌引擎模块。</description>

    <dependencies>
        <dependency>
            <groupId>com.turbofeed</groupId>
            <artifactId>tf-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 健康检查（K8s 探活 / 未来 Prometheus 指标入口），与 tf-counter / tf-feed-engine 对齐 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- JDBC 持久层：media 元数据落库（P1）。复用 ShardingSphere 已装配的 DataSource，
             经 JdbcTemplate 读写分片后的 media 表；版本由 Spring Boot BOM 托管。
             一并带来 HikariCP，与 shardingsphere-config.yaml 引用的 HikariDataSource 对齐。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Sentinel：timeline QPS 限流 + 点赞热点参数限流 + 依赖熔断 + 系统自适应保护 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <!-- Redis（Lettuce）：上传接口用户级限流等轻量 KV 用途（版本由 Boot BOM 托管）。
             与 tf-counter / tf-feed-engine 的 Redisson 是不同选型：网关只需 RedisTemplate 级
             原子命令（INCR/EXPIRE），不需要分布式锁与丰富数据结构，避免重依赖。
             Lettuce 连接懒建立：本地未启动 Redis 不影响应用启动 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Lettuce 连接池依赖：commons-pool2 是 lettuce-core 的 optional 依赖，不会随
             spring-boot-starter-data-redis 传递引入；application.yml 启用了
             lettuce.pool.enabled=true，必须显式声明，否则启动报
             NoClassDefFoundError: org/apache/commons/pool2/impl/GenericObjectPoolConfig。
             版本由 spring-boot-dependencies BOM 托管，无需写 version。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <!-- ShardingSphere JDBC 内核：分库分表原生驱动（驱动类 org.apache.shardingsphere.driver.ShardingSphereDriver，
             由 application.yml 的 spring.datasource.url=jdbc:shardingsphere:classpath:shardingsphere-config.yaml 启用，
             无需 spring-boot-starter）。当前仅网关元数据(user 表)分片使用；
             实际分片算法用 Apache ShardingSphere 5.5.3 内置 HASH_MOD（type: HASH_MOD + props.sharding-count），
             见 shardingsphere-config.yaml shardingAlgorithms 段；不需业务侧自定义算法类（曾自写但已于 0012 改回内置）。
             ⚠️ artifactId 必须是 `shardingsphere-jdbc`（5.x 统一名称），不是 `shardingsphere-jdbc-core`，
             后者在 Maven Central 不存在，会导致 import org.apache.shardingsphere.* 全军报红。
             版本选择：5.5.3（2026-02-23 发布），相比 5.5.0 已修复 test-util 缺失发布的 release 缺陷，
             详见 Apache PR #31143（"Removes test modules that are not deployed to Maven Central Repository"）与
             GitHub issue #31128/#32256。 -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-jdbc</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- ShardingSphere classpath: URL 加载器：shardingsphere-jdbc 5.5.3 的上游 pom 误把
             shardingsphere-infra-url-classpath 声明为 test scope，不会传递到使用方的运行时
             classpath，导致 jdbc:shardingsphere:classpath:shardingsphere-config.yaml 初始化报
             SPI-00001: No implementation class load from SPI 'ShardingSphereModeConfigurationURLLoader'
             with type 'classpath:'（HikariPool-1 起不来，首个碰库请求 500）。
             接口在 5.5.0→5.5.3 间由 ShardingSphereURLLoader 改名而来，实现类 ClassPathURLLoader
             仍在该模块。此处显式声明以覆盖上游 test scope（直接声明优先于传递依赖的 scope）。 -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-infra-url-classpath</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- ⚠️ ShardingSphere 5.5.3 上游打包回归：shardingsphere-jdbc:5.5.3.pom 把以下运行期
             必需模块全部声明为 <scope>test</scope>（见其 pom 第 91-135 行），不会传递到使用方的
             运行时 classpath，导致驱动初始化连环失败：
               · shardingsphere-sharding-core            → 缺则 YAML 解析报 Invalid tag: !SHARDING
               · shardingsphere-parser-sql-engine-mysql  → 缺则无法解析 MySQL 业务 SQL
               · shardingsphere-parser-sql-engine-sql92  → 通用 SQL 解析引擎（兜底）
               · shardingsphere-infra-data-source-pool-hikari → 缺则无法创建 Hikari 连接池数据源
               · shardingsphere-standalone-mode-repository-memory → 缺则 classpath 配置 standalone 内存仓库加载失败
               · shardingsphere-authority-simple         → 默认权限提供器（缺则 authority rule 构建失败）
             此处逐一显式声明 5.5.3 以覆盖上游 test scope（直接声明优先于传递依赖 scope）。
             唯一未声明的是 shardingsphere-test-infra-fixture-database（纯上游测试设施，使用方无需）。 -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-sharding-core</artifactId>
            <version>5.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-parser-sql-engine-mysql</artifactId>
            <version>5.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-parser-sql-engine-sql92</artifactId>
            <version>5.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-infra-data-source-pool-hikari</artifactId>
            <version>5.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-standalone-mode-repository-memory</artifactId>
            <version>5.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-authority-simple</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- 密码哈希：Spring Security Crypto 的 BCryptPasswordEncoder（仅加密工具类，
             不引入 Spring Security Web / 鉴权自动配置；版本由 spring-boot-dependencies BOM 托管，无需写 version）。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- MySQL 驱动：ShardingSphere-JDBC 不内置任何数据库驱动，必须由应用侧显式声明！
             否则底层 Hikari 池建连时 ClassNotFoundException 被包装成
             "Failed to initialize pool: null"（message 为 null，根因被吞）。
             版本由 spring-boot-dependencies BOM 托管（Spring Boot 3.4.3 → mysql-connector-j 8.0.33/9.x，
             本地 .m2 已有 8.0.33，兼容）。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!-- ShardingSphere 5.5.3 运行期依赖 commons-lang3（SystemSchemaManager 静态初始化引用
             org.apache.commons.lang3.Strings）。⚠️ 关键坑：spring-boot-dependencies 3.4.3 BOM 把
             commons-lang3 锁定为 3.17.0，而 org.apache.commons.lang3.Strings 这个 class 直到
             commons-lang3 3.18.0 才引入（3.17.0 及更早版本根本没有 Strings.class），导致
             NoClassDefFoundError: org/apache/commons/lang3/Strings。此处显式锁 3.18.0 覆盖 BOM。
             本地 .m2 已有 3.18.0（含 Strings 类），无需联网下载；根 pom dependencyManagement 也同步覆盖。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>
        <!-- RocketMQ：媒体上传事件异步化（Observer 事件总线的跨进程实现）。
             2.3.x 兼容 Spring Boot 3.x（2.3.4 已修复 MessageModel 包路径冲突）。
             默认不激活：未配置 rocketmq.name-server 时 starter 自动配置不生效，
             且自定义发布器/消费者由 turbofeed.mq.enabled=true 才激活（保克隆即跑） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.3.5</version>
        </dependency>
        <!-- Lombok：@RequiredArgsConstructor 简化构造器注入（版本由 Spring Boot BOM 托管；optional 不参与传递、不打入可执行 jar） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 对象存储客户端（MinIO / 兼容 S3）：百亿级媒体文件的存储落点。
             仅 turbofeed.media.storage=minio 时由 MinioStorageClient 使用（ConditionalOnProperty），
             默认 local 磁盘存储不会加载本依赖的任何类，不影响克隆即跑。Java 17 兼容（SDK 要求 11+）。 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.7</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.turbofeed.gateway.GatewayApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
