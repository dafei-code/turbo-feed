<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.turbofeed</groupId>
        <artifactId>turbo-feed</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tf-gateway</artifactId>
    <name>tf-gateway</name>
    <description>HTTP 接入层：聚合 Feed / 计数 / 热点三大引擎的对外 API（可执行 jar，默认端口 8080）+ Sentinel 流量防护</description>

    <dependencies>
        <dependency>
            <groupId>com.turbofeed</groupId>
            <artifactId>tf-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>com.turbofeed</groupId>
            <artifactId>tf-hotspot</artifactId>
        </dependency>
        <dependency>
            <groupId>com.turbofeed</groupId>
            <artifactId>tf-feed-engine</artifactId>
            <!-- tf-gateway 为 HTTP 接入层，不消费 Redis；排除 Redisson 传递依赖，
                 避免 RedissonAutoConfiguration 在本进程自动激活（连不上 Redis 启动失败）。
                 tf-feed-engine / tf-counter 独立成服务时各自 pom 仍持有 Redisson，不受影响 -->
            <exclusions>
                <exclusion>
                    <groupId>org.redisson</groupId>
                    <artifactId>redisson-spring-boot-starter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.turbofeed</groupId>
            <artifactId>tf-counter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.redisson</groupId>
                    <artifactId>redisson-spring-boot-starter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Sentinel：timeline QPS 限流 + 点赞热点参数限流 + 依赖熔断 + 系统自适应保护 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <!-- RocketMQ：媒体上传事件异步化（Observer 事件总线的跨进程实现）。
             2.3.x 兼容 Spring Boot 3.x（2.3.4 已修复 MessageModel 包路径冲突）。
             默认不激活：未配置 rocketmq.name-server 时 starter 自动配置不生效，
             且自定义发布器/消费者由 turbofeed.mq.enabled=true 才激活（保克隆即跑） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.3.4</version>
        </dependency>
        <!-- Lombok：@RequiredArgsConstructor 简化构造器注入（版本由 Spring Boot BOM 托管；optional 不参与传递、不打入可执行 jar） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.turbofeed.gateway.GatewayApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
