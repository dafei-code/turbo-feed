# =============================================================================
# turbo-feed 生产环境变量清单（模板）
#
# 用法：
#   cp deploy/env/.env.example deploy/env/.env
#   填入真实值 → bash deploy/scripts/preflight.sh deploy/env/.env → 起服务
#
# ⚠️ deploy/env/.env 是明文密钥文件，必须加入 .gitignore（仓库已忽略 .env）。
# ⚠️ 生产真机上这套应换成 KMS / Vault / K8s Secret 注入；本文件只是单机 compose 的过渡方案。
# =============================================================================

# ───────────────────────────── 必填（缺失则启动失败）─────────────────────────────

# MySQL 账号。生产不要用 root，建一个只对 turbo_feed_1 / turbo_feed_2 有权限的账号。
TURBOFEED_DB_USERNAME=turbofeed
TURBOFEED_DB_PASSWORD=

# JWT 签名密钥（HS256）。**至少 32 字符**，且必须是随机值：
#   openssl rand -base64 48
# prod profile 无默认值，缺失或过短会直接启动失败——这是刻意的，不要改成兜底值。
TURBOFEED_JWT_SECRET=

# 网关 ↔ 引擎内部调用令牌。两端必须完全相同，不匹配会导致引擎侧 401（表现为整页无内容）。
#   openssl rand -hex 32
TURBOFEED_INTERNAL_TOKEN=

# MinIO 凭据（对象存储：图片/视频）。生产禁止用 minioadmin。
TURBOFEED_MINIO_ACCESS_KEY=
TURBOFEED_MINIO_SECRET_KEY=

# 媒体文件对外可访问的 URL 前缀（客户端拿到的直链由它拼出来）。
# 生产必须是外部可达地址；写成 http://minio:9000/... 会让客户端拿到内网域名、图全裂。
TURBOFEED_MEDIA_PUBLIC_URL_BASE=https://cdn.example.com/turbo-feed-media/

# ───────────────────────────── Redis 拓扑 ─────────────────────────────

# single | cluster | sentinel。生产用 cluster（三主三从见 deploy/redis/docker-compose-cluster.yml）。
# ⚠️ 根目录开发编排的默认值是 single，那是本地用的；生产编排在不设时默认 cluster。
TURBOFEED_REDIS_MODE=cluster

# cluster 模式必填：节点列表（任取几个可达节点即可，客户端会自动发现全拓扑）。
TURBOFEED_REDIS_CLUSTER_NODES=redis-0:7000,redis-1:7000,redis-2:7000

TURBOFEED_REDIS_PASSWORD=

# ───────────────────────────── 服务与镜像 ─────────────────────────────

# 网关对宿主发布的端口（默认 8080）。裸 HTTP，生产必须在前面放 TLS 终结。
TURBOFEED_GATEWAY_HOST_PORT=8080

# 镜像 tag：用 git commit sha 或语义版本，禁止长期用 latest（回滚时无法确定是哪个版本）。
TURBOFEED_IMAGE_TAG=latest

# 雪花 ID 的机器位。多实例部署时必须各不相同，否则会生成重复 ID。
# 取值范围 0~31（worker）/ 0~31（datacenter），总计 1024 个组合。
TURBOFEED_SNOWFLAKE_WORKER_ID=1
TURBOFEED_SNOWFLAKE_DATACENTER_ID=1

# ───────────────────────────── 可选开关 ─────────────────────────────

# RocketMQ。默认 false：仓库里 rocketmq-spring 2.3.5 在无 name-server 时会建 Bean 失败，
# 所以「不开」是安全默认。真要用，必须同时起 namesrv + broker，并确保主题已建。
TURBOFEED_MQ_ENABLED=false

# ── 行为明细（推荐训练样本）──────────────────────────────────────────────────
# ⚠️ 变量名必须带 FEED！属性是 turbofeed.feed.behavior-log.enabled。
#    写成 TURBOFEED_BEHAVIOR_LOG_ENABLED 不会报任何错，只会静默读到默认 false——
#    表现为「环境变量设了、日志没异常、数据一条没有」。
TURBOFEED_FEED_BEHAVIOR_LOG_ENABLED=true
TURBOFEED_FEED_BEHAVIOR_LOG_DIR=/app/logs/behavior
# 队列容量：满时直接丢弃并计数（埋点丢样本 < 卡住请求）。高峰实例可调大。
TURBOFEED_FEED_BEHAVIOR_LOG_QUEUE_CAPACITY=50000

# 打开上面的开关只是第一步：数据落在 behavior-logs 命名卷里，**还需要显式做采集与备份**，
# 否则容器重建/磁盘故障仍会丢。完整链路见 docs/architecture/behavior-data-pipeline.md。
