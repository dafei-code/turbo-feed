# =============================================================================
# turbo-feed 多副本（阶段 B1）开关模板 —— 只列开关，不写任何密钥
#
# 用法：
#   cp deploy/env/.env.multinode.example deploy/env/.env.multinode
#   按需打开下面的开关 → 注入到三个服务进程（见 docs/ops/multinode-switches.md）
#
# ⚠️ 这份文件本身**不会自动生效**：compose 的 environment: 段是白名单，
#    只转发显式列出的变量。未接线前，这里的值进不了容器（历史坑：
#    TURBOFEED_BEHAVIOR_LOG_ENABLED 设了却静默按默认值走）。
# 前置状态（2026-11-16，见 docs/ops/multinode-switches.md §3）：
#   ① tf-counter 共享数据源 —— 已落地（application-prod.yml + 01-counter-shared-db.sql）
#   ② compose environment 转发 —— 已落地（三段均补 :-false 转发）
#   ③ Redis 集群在线且凭据就绪 —— 仍需部署方准备；本机 Docker 未运行，本轮未做真启动验证
# ⚠️ 已有 MySQL 环境需手工执行 deploy/compose/mysql/01-counter-shared-db.sql：
#    initdb 只在空数据卷首次初始化时跑，重启容器不会自动补建共享库。
# =============================================================================

# ── Redis 拓扑（三个服务必须一起切，engine 注释记录过「只改一侧→推荐流静默全空」）──
TURBOFEED_REDIS_MODE=cluster
TURBOFEED_REDIS_CLUSTER_NODES=redis-0:7000,redis-1:7000,redis-2:7000
# 口令沿用 prod 已有的 TURBOFEED_REDIS_PASSWORD，本模板不重复、不写明文。

# ── Redisson 客户端（counter 共享缓冲的前置；tf-redis 的 RedissonTopologyConfig）──
# 属性键：turbofeed.redis.redisson-enabled（FeatureFlagKeys.REDIS_REDISSON_ENABLED）
# 默认 false：Redisson.create() 立即建连，Redis 不可达即启动失败。
TURBOFEED_REDIS_REDISSON_ENABLED=true

# ── 雪花 worker-id 自租约（已有实现 WorkerIdLeaseManager，无需改代码）──────────
# 属性键：turbofeed.snowflake.lease-enabled（application.yml 已有 ${...:false} 占位符）
# true 后 worker-id 由 Redis SET NX EX 抢占 + 后台续约，扩容不用逐实例配号。
# ⚠️ datacenter-id 仍需逐实例显式配置，租约只解决 worker-id 一半位段。
# ⚠️ Redis 不可用即启动失败；续约失败 fail-closed 停止发号（刻意设计，勿改）。
TURBOFEED_SNOWFLAKE_LEASE_ENABLED=true
TURBOFEED_SNOWFLAKE_DATACENTER_ID=1

# ── tf-counter 共享缓冲 + ShedLock 选主（三个开关必须同时打开）─────────────────
# 属性键（注意是连字符，不是点号；拼错会静默 no-op）：
#   turbofeed.counter.redis-enabled          → TURBOFEED_COUNTER_REDIS_ENABLED
#   turbofeed.counter.redis-buffer-enabled   → TURBOFEED_COUNTER_REDIS_BUFFER_ENABLED
# FeatureFlagGuard.validateCounterBuffer()：buffer=true 但 redis=false 直接启动失败。
TURBOFEED_COUNTER_REDIS_ENABLED=true
TURBOFEED_COUNTER_REDIS_BUFFER_ENABLED=true

# ── 网关侧 tf-counter 总闸（打开发送计数增量；yml 已有 ${...:false} 占位符）────
TURBOFEED_COUNTER_ENABLED=true

# ── 账号状态缓存跨实例失效广播：默认已开，显式写出便于核对，保持 true ──────────
# 属性键：turbofeed.state-cache.broadcast-enabled
TURBOFEED_STATE_CACHE_BROADCAST_ENABLED=true

# ── 阶段 B2：词库 / 白名单跨实例 epoch 广播 ──────────────────────────────────
# 属性键：turbofeed.content-security.epoch-broadcast-enabled
# 开启后 admin 改词库/白名单会推进 Redis 全局 epoch 并 pub/sub 通知其它网关实例立即重建；
# 关闭（默认）时退化为各实例 30s (COUNT, MAX(updated_at)) 指纹刷新。
# ⚠️ 只影响网关；prod compose 已在 gateway 段用 :-false 转发本变量。
# ⚠️ epoch Key（tf:mod:dict:epoch / tf:mod:whitelist:epoch）不设 TTL，切勿 FLUSHDB；
#    误清后各实例基线会在 30s 兜底里自动跟随回退，期间一致性由 CheckSum 定时兜底。
TURBOFEED_CONTENT_SECURITY_EPOCH_BROADCAST_ENABLED=true

# =============================================================================
# 【刻意不打开】热点榜 L1 缓存广播
#   turbofeed.feed.hotkey-cache.broadcast-enabled 在 engine/application.yml 写死 false，
#   注释明确：热点榜 ZSET 每次行为事件都更新，照搬「每次变更广播」会淹没 pub/sub，
#   故按设计只用 5s 短 TTL 失效。多副本下这不是缺陷，不要为了让「广播全开」而改它。
#   变量 TURBOFEED_FEED_HOTKEY_CACHE_BROADCAST_ENABLED 也不存在占位符，勿凭猜测添加。
# =============================================================================
