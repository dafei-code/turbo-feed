# =============================================================================
# turbo-feed 多副本（阶段 B1）开关模板 —— 只列开关，不写任何密钥
#
# 用法：
#   cp deploy/env/.env.multinode.example deploy/env/.env.multinode
#   按需打开下面的开关 → 注入到三个服务进程（见 docs/ops/multinode-switches.md）
#
# ⚠️ 这份文件本身**不会自动生效**：compose 的 environment: 段是白名单，
#    只转发显式列出的变量。未接线前，这里的值进不了容器（历史坑：
#    TURBOFEED_BEHAVIOR_LOG_ENABLED 设了却静默按默认值走）。
# 前置状态（2026-11-16，见 docs/ops/multinode-switches.md §3）：
#   ① tf-counter 共享数据源 —— 已落地（application-prod.yml + 01-counter-shared-db.sql）
#   ② compose environment 转发 —— 已落地（三段均补 :-false 转发）
#   ③ Redis 集群在线且凭据就绪 —— 仍需部署方准备；本机 Docker 未运行，本轮未做真启动验证
# ⚠️ 已有 MySQL 环境需手工执行 deploy/compose/mysql/01-counter-shared-db.sql：
#    initdb 只在空数据卷首次初始化时跑，重启容器不会自动补建共享库。
# =============================================================================

# ── Redis 拓扑（三个服务必须一起切，engine 注释记录过「只改一侧→推荐流静默全空」）──
TURBOFEED_REDIS_MODE=cluster
TURBOFEED_REDIS_CLUSTER_NODES=redis-0:7000,redis-1:7000,redis-2:7000
# 口令沿用 prod 已有的 TURBOFEED_REDIS_PASSWORD，本模板不重复、不写明文。

# ── Redisson 客户端（counter 共享缓冲的前置；tf-redis 的 RedissonTopologyConfig）──
# 属性键：turbofeed.redis.redisson-enabled（FeatureFlagKeys.REDIS_REDISSON_ENABLED）
# 默认 false：Redisson.create() 立即建连，Redis 不可达即启动失败。
TURBOFEED_REDIS_REDISSON_ENABLED=true

# ── 雪花 worker-id 自租约（已有实现 WorkerIdLeaseManager，无需改代码）──────────
# 属性键：turbofeed.snowflake.lease-enabled（application.yml 已有 ${...:false} 占位符）
# true 后 worker-id 由 Redis SET NX EX 抢占 + 后台续约，扩容不用逐实例配号。
# ⚠️ datacenter-id 仍需逐实例显式配置，租约只解决 worker-id 一半位段。
# ⚠️ Redis 不可用即启动失败；续约失败 fail-closed 停止发号（刻意设计，勿改）。
TURBOFEED_SNOWFLAKE_LEASE_ENABLED=true
TURBOFEED_SNOWFLAKE_DATACENTER_ID=1

# ── tf-counter 共享缓冲 + ShedLock 选主（三个开关必须同时打开）─────────────────
# 属性键（注意是连字符，不是点号；拼错会静默 no-op）：
#   turbofeed.counter.redis-enabled          → TURBOFEED_COUNTER_REDIS_ENABLED
#   turbofeed.counter.redis-buffer-enabled   → TURBOFEED_COUNTER_REDIS_BUFFER_ENABLED
# FeatureFlagGuard.validateCounterBuffer()：buffer=true 但 redis=false 直接启动失败。
TURBOFEED_COUNTER_REDIS_ENABLED=true
TURBOFEED_COUNTER_REDIS_BUFFER_ENABLED=true

# ── 网关侧 tf-counter 总闸（打开发送计数增量；yml 已有 ${...:false} 占位符）────
TURBOFEED_COUNTER_ENABLED=true

# ── 账号状态缓存跨实例失效广播：默认已开，显式写出便于核对，保持 true ──────────
# 属性键：turbofeed.state-cache.broadcast-enabled
TURBOFEED_STATE_CACHE_BROADCAST_ENABLED=true

# ── 阶段 B2：词库 / 白名单跨实例 epoch 广播 ──────────────────────────────────
# 属性键：turbofeed.content-security.epoch-broadcast-enabled
# 开启后 admin 改词库/白名单会推进 Redis 全局 epoch 并 pub/sub 通知其它网关实例立即重建；
# 关闭（默认）时退化为各实例 30s (COUNT, MAX(updated_at)) 指纹刷新。
# ⚠️ 只影响网关；prod compose 已在 gateway 段用 :-false 转发本变量。
# ⚠️ epoch Key（tf:mod:dict:epoch / tf:mod:whitelist:epoch）不设 TTL，切勿 FLUSHDB；
#    误清后各实例基线会在 30s 兜底里自动跟随回退，期间一致性由 CheckSum 定时兜底。
TURBOFEED_CONTENT_SECURITY_EPOCH_BROADCAST_ENABLED=true

# =============================================================================
# 【突发档 / 爆款单帖】RocketMQ 削峰（评审优化项①，默认全关）
#
# 仅在大促 / 热搜 / 预期单帖万级集中流量时启用。日常保持默认形态
# （mq 关 + HTTP 计数 + 进程内异步落库）即可，不必常驻 MQ。
#
# ⚠️ 三个服务必须同时激活 mq profile 且连同一个 NameServer：
#    网关发 MQ、tf-counter 消费、engine 行为事件，任一漏开都会「一边发 MQ 一边等 HTTP」。
# ⚠️ NameServer / Broker 不在 prod compose 里，需部署方自备集群（至少 1 namesrv + 1 broker）；
#    仓库根 docker-compose.yml 的 tf-rocketmq-namesrv 只作本地开发参考，勿直接用于生产。
# ⚠️ compose 的 environment: 是白名单，本段变量已在三段服务中显式转发，勿只改本文件。
# =============================================================================
# 激活 prod + mq 两个 profile（compose 默认仅 prod，未设置时零回归）
TURBOFEED_SPRING_PROFILES=prod,mq
TURBOFEED_MQ_ENABLED=true
TURBOFEED_ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
# 计数总闸 TURBOFEED_COUNTER_ENABLED=true 已在上方「网关侧 tf-counter 总闸」打开，勿重复。
# MQ 发送失败时的 HTTP 直投兜底目标：容器内必须指向服务名，指向 localhost 会打到网关自己。
TURBOFEED_COUNTER_BASE_URL=http://tf-counter:8081

# ── 评审优化项③：热点帖计数 Key 分槽（默认关，与突发档相互独立）────────────────
# ⚠️ 只在实测「热点 Redis slot 所在节点 CPU 先打满」时打开；列表页读命令数放大约 64 倍，
#    小集群 / 单副本打开大概率变慢。compose 已在 gateway 段用 :-false 转发。
# ⚠️ 关闭前必须先对每个有分槽数据的帖子执行 foldBack 回灌，否则计数会退回
#    「开启前的旧快照」，开启期间的增量全部消失。详见 docs/ops/hotspot-count-sharding.md §六。
# TURBOFEED_LIKE_COUNT_SHARDING_ENABLED=true

# ── 评审优化项④-a：评论列表页短 TTL 缓存（默认关）────────────────────────────
# 只缓存 DB 行快照；点赞数 / 评论总数仍实时读 Redis；落库成功后按 generation 失效全部页。
# 适用：爆款帖评论区翻页把 comment_N 单张物理分片的读 QPS 打满。
# 代价：发布 QPS 很高时 generation 频繁推进，命中率下降；缓存最长滞后一个 TTL。
# compose 已在 gateway 段用 :-false / :-2000 转发，勿只改本文件。
# TURBOFEED_COMMENT_PAGE_CACHE_ENABLED=true
# TURBOFEED_COMMENT_PAGE_CACHE_TTL_MS=2000

# ── 评审优化项④-b：读写分离真实副本（默认回落主库，需部署方自备副本）──────────
# !READWRITE_SPLITTING 规则早已在 shardingsphere-config-128.yaml 里配好，
# 缺的只是部署侧真实副本 URL：prod compose 未设置时 ds_0_read / ds_1_read 指回主库
# mysql:3306（读主，零回归），只有显式给出下列两个 URL，读请求才真正分流到副本。
# ⚠️ 副本必须已配好原生复制且可连；指错地址会让「读」全量失败（写主库不受影响）。
#    这也是默认值刻意回落主库、而不是直配 3307 的原因（见 docs/changelog/0051）。
# ⚠️ transactionalReadQueryStrategy: PRIMARY：事务内读仍走主库，规避写后读复制延迟。
# ⚠️ 下列 host 只是示例，替换成部署环境真实的副本地址；JDBC 参数与主库保持一致。
# TURBOFEED_REPLICA_DB_0_URL=jdbc:mysql://mysql-replica-0:3306/turbo_feed_1?useUnicode=true&characterEncoding=UTF-8&rewriteBatchedStatements=true&allowMultiQueries=true&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
# TURBOFEED_REPLICA_DB_1_URL=jdbc:mysql://mysql-replica-1:3306/turbo_feed_2?useUnicode=true&characterEncoding=UTF-8&rewriteBatchedStatements=true&allowMultiQueries=true&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false

# ── PR-B / PR-D2：上传链路 MEDIA_UPLOADED 发件箱灰度（默认关）─────────────────
# 关闭：整帖 batchInsert 仍带事务，但事件仍由原 MediaEventPublisher 直发（零回归）。
# 打开：media 行 + 事件行同事务，afterCommit 快路径直投，失败留行由 OutboxRelay 补偿；
#       不再直发，绝不双跑。回退只需把开关改回 false（事件行是新增数据，旧路径不读它）。
# ⚠️ 打开前确认 outbox_event 单表写入容量：上传 QPS 全量进单表会制造新的写入热点，
#    这是 D1「评论不落 Outbox」的同一条理由；建议按灰度比例逐步放开并盯
#    tf_outbox_backlog{status} 与 tf_outbox_oldest_age_seconds{status}。
# compose 已在 gateway 段用 :-false 转发，勿只改本文件。
# TURBOFEED_OUTBOX_MEDIA_UPLOADED_ENABLED=true

# ── PR-D5：发件箱传输通道（留空 = 跟随 TURBOFEED_MQ_ENABLED）──────────────────
# 只有确实存在两种传输实现的事件才需要它：MEDIA_UPLOADED 的 LOCAL=应用内事件、
# MQ=RocketMQ；TIMELINE_* 由 FeedTimelinePublisher 端口按总闸选实现，STORAGE_DELETE
# 只有本地对象存储 IO。单类型键只覆盖该事件，便于灰度/排障时强制本地或强制 MQ。
# ⚠️ 只允许 local / mq / 留空，其它取值应用启动即失败（fail-fast，不静默回退）。
# TURBOFEED_OUTBOX_CHANNEL_DEFAULT=mq
# TURBOFEED_OUTBOX_CHANNEL_MEDIA_UPLOADED=local

# ── PR-D3：时间线墓碑防旧（引擎侧，默认开启）─────────────────────────────────
# 拦截「APPEND 判死 → 同帖下架 → Sweeper/DLQ 重投 APPEND」把已下架内容复活。
# 默认 true，无需在此显式打开；零回归由「存量事件行没有 occurredAt → 一律放行」保证。
# 只有在出现误拦（如时钟回拨、跨实例时钟偏差）需要紧急回退时才设为 false：
# TURBOFEED_FEED_TIMELINE_TOMBSTONE_ENABLED=false
# 墓碑 TTL 默认 30 天，覆盖 DLQ / 发件箱最长滞留窗口；调小会让极迟到的 APPEND 重新可入流。
# TURBOFEED_FEED_TIMELINE_TOMBSTONE_TTL_DAYS=30
# 详见 docs/ops/timeline-tombstone.md。compose 已在 engine 段转发这两个变量。

# =============================================================================
# 【刻意不打开】热点榜 L1 缓存广播
#   turbofeed.feed.hotkey-cache.broadcast-enabled 在 engine/application.yml 写死 false，
#   注释明确：热点榜 ZSET 每次行为事件都更新，照搬「每次变更广播」会淹没 pub/sub，
#   故按设计只用 5s 短 TTL 失效。多副本下这不是缺陷，不要为了让「广播全开」而改它。
#   变量 TURBOFEED_FEED_HOTKEY_CACHE_BROADCAST_ENABLED 也不存在占位符，勿凭猜测添加。
# =============================================================================
